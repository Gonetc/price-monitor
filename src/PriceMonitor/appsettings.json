{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Scraper": {
    "BaseUrl": "https://books.toscrape.com/",
    "StartPath": "catalogue/page-1.html",
    "MaxPages": 50,
    "DelayBetweenRequestsMs": 500,
    "UserAgent": "PriceMonitor/1.0 (+https://github.com/Gonetc)"
  },
  "Monitor": {
    "OutputFolder": "output",
    "CurrencyFormat": "£#,##0.00",
    "IntervalMinutes": 0
  }
}
